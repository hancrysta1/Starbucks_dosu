<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.multi.spring2.security.mapper.UserDetailsMapper">
    <resultMap id="customerMap" type="Customer" autoMapping="true">
        <id property="id" column="id"/>
        <collection property="auths" ofType="CustomerAuth"  autoMapping="true">
        </collection>
    </resultMap>


    <select id="get"
            parameterType="string"
            resultMap="customerMap">
        select c.*, a.auth
        from
        customer c left outer join customer_auth a
        on c.id = a.id
        where c.id = #{id}
    </select>
</mapper>