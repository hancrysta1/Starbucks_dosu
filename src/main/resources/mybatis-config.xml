<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-config.dtd">
<!--사용안함-->
<configuration>
    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
    </settings>
    <typeAliases>
        <typeAlias type="com.multi.spring2.product.vo.Product"     alias="Product"/>
        <typeAlias type="com.multi.spring2.customer.vo.Customer"   alias="Customer"/>
        <typeAlias type="com.multi.spring2.order.vo.OrderInfo"     alias="OrderInfo"/>
        <typeAlias type="com.multi.spring2.order.vo.OrderLine"     alias="OrderLine"/>
        <typeAlias type="com.multi.spring2.security.vo.CustomerAuth" alias="CustomerAuth"/>
    </typeAliases>

</configuration>